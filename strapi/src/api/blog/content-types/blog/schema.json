{
  "kind": "singleType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "blog_title": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "default": "talque Blogs"
    },
    "blog_description": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text",
      "default": "Welcome to our blog! Here you will find many useful articles on the topics of digital, hybrid and analogue events. Discover new functions, best practices based on case studies and immerse yourself in the behind the scenes of our office.",
      "required": true
    }
  }
}
